# Local operating database. Created on first launch if missing.
DATABASE_PATH=./data/hayden.db

# Chief of Staff model. Leave blank until you choose a provider.
# The key is read only on the server. Do not put it in client code.
# AI_PROVIDER: xai, openai, or anthropic
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Image generation. Official xAI Imagine API. The key stays on the server.
# If IMAGE_API_KEY is blank, an xAI AI_API_KEY is used. Do not commit a key.
IMAGE_PROVIDER=xai
IMAGE_MODEL=grok-imagine-image-2.0
IMAGE_API_KEY=
ASSET_STORAGE_PATH=./data/assets

# Scene video. Official Gemini Omni Flash. Paid Gemini API key. Do not commit a key.
# Until this is set, Generate video explains what is missing and does not submit a job.
VIDEO_PROVIDER=gemini
VIDEO_MODEL=gemini-omni-1.1-flash
GEMINI_API_KEY=

# Rented GPU proof. Separate from Gemini. The key stays on the server. Do not commit it.
# Leave GPU_WORKER_URL blank. Hayden OS creates the worker address when it starts the GPU.
GPU_PROVIDER=runpod
RUNPOD_API_KEY=
GPU_WORKER_TOKEN=
GPU_WORKER_URL=

# Integration secrets. Leave blank until a connector is actually wired.
META_ADS_ACCESS_TOKEN=
# Google Drive OAuth. Create a Web client in Google Cloud, enable the Drive API,
# and add this redirect URI. Leave blank until then. Never put a refresh token here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3210/api/integrations/google/callback
# Encrypts Drive tokens in the local database. Generate a long random string. Do not commit it.
DRIVE_TOKEN_KEY=
CRM_API_KEY=
# Optional. Settings is the normal place. Stored values are encrypted with DRIVE_TOKEN_KEY.
AIRCALL_API_ID=
AIRCALL_API_TOKEN=
# One private token belongs to one GoHighLevel location. Map that location to one business in Settings.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
METRICOOL_API_KEY=
ACCOUNTING_API_KEY=
